<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    本 POM 【不继承 framework-parent】—— 与 framework-cache-redis-starter/framework-crypto-starter
    同一个理由：插件独立成仓后，它对框架的关系与业务方完全相同，通过 import framework-bom 拿版本仲裁，
    而不是靠继承拿到一整套构建配置。用同一套姿势消费框架，业务方会遇到的问题就会先在这里暴露。

    代价是下面这些构建配置要自带一份：
      - release=17                产物必须能跑在 Java 17 上（构建用哪个 JDK 不作要求）
      - enforcer 的 requireJavaVersion  唯一的构建前提：JDK >= 17
      - surefire 的 UTF-8         中文 Windows 上默认 GBK，断言里的中文会对不上（CLAUDE.md 3.6）
      - enforcer 的两条 ban       JDBC 驱动、Jackson 3
    唯独【不带】framework 仓里的 enforce-core-thin —— 本插件的职责就是引入 POI（经 Apache Fesod）。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-excel-starter</artifactId>
  <version>0.2.1</version>
  <packaging>jar</packaging>

  <name>describeadmin :: framework-excel-starter</name>
  <description>Excel 导入导出插件：门面 ExcelExporter/ExcelImporter + @ExcelResponse/@ExcelBody 注解与 MVC 糖，基于 Apache Fesod（孵化中）</description>
  <url>https://github.com/describeadmin/framework-excel-starter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework-excel-starter.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework-excel-starter.git</developerConnection>
    <url>https://github.com/describeadmin/framework-excel-starter</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 不对构建 JDK 做版本要求，唯一前提是 JDK >= 17（enforcer 的 requireJavaVersion 兜底）。 -->
    <maven.compiler.release>17</maven.compiler.release>
    <enforcer.java.version>[17,)</enforcer.java.version>

    <!--
      ⚠️ 本插件构建所针对的框架版本，必须与
      FrameworkExcelAutoConfiguration.REQUIRED_FRAMEWORK_VERSION 对得上——
      那个常量是运行期自检读的，这个属性是构建期解析用的，两者说的是同一件事。
      插件自身版本号（上面的 <version>）与它【不联动】。
      CI 的兼容性矩阵靠覆盖它实现：mvn -B test -Ddescribeadmin.version=0.3.0
    -->
    <describeadmin.version>0.2.0</describeadmin.version>

    <!--
      Apache Fesod（孵化中）—— Alibaba EasyExcel / FastExcel 的 ASF 捐赠版。
      版本已核实 https://repo1.maven.org/maven2/org/apache/fesod/fesod-sheet/maven-metadata.xml
      的 <release> 真实存在。注意 "-incubating" 是版本号的一部分，不能省。
      fesod-sheet 传递引入 org.apache.poi:poi(-ooxml) 5.5.1 / commons-csv / ehcache /
      fesod-common / fesod-shaded / slf4j-api；fesod-shaded 已核实【不含】任何 Jackson。

      ⚠️【不 import fesod-bom】：实测 fesod-bom 2.0.2-incubating 只仲裁 slf4j-api 1.7.36
      与 lombok，既没管 fesod-sheet 自己的版本（import 了还是要写字面量），又会把 slf4j
      降到 1.7.x 顶掉 Spring Boot 3.5 的 slf4j 2.x。因此直接给 fesod-sheet 写死版本，
      slf4j / lombok 的版本仲裁交回给 framework-bom → spring-boot-dependencies。

      ⚠️ Fesod 仍在 ASF 孵化，其 POM 自述 EasyExcel 衍生代码 IP clearance 尚未完成，
      下游需自行做许可审查（见 README「兼容性」小节）。
    -->
    <fesod.version>2.0.2-incubating</fesod.version>

    <!--
      CVE-2025-48924（commons-lang3 < 3.18.0，ClassUtils.getClass 超长输入触发
      StackOverflowError）。fesod-sheet → poi 5.5.1 传递引入 commons-lang3，
      而 spring-boot-dependencies 3.5.16（经 framework-bom）把它仲裁在 3.17.0。
      在下方 dependencyManagement 里显式钉到 3.18.0（修复版本）覆盖之——
      该条目必须排在 framework-bom 的 import 之前，Maven 才会让它生效。
      版本已核实 https://repo1.maven.org/maven2/org/apache/commons/commons-lang3/maven-metadata.xml。
    -->
    <commons-lang3.version>3.18.0</commons-lang3.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        CVE-2025-48924 修复：必须排在 framework-bom（→ spring-boot-dependencies 3.17.0）
        的 import 之前，first-declaration-wins 才能让 3.18.0 生效。
      -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3.version}</version>
      </dependency>

      <!--
        业务方的姿势：只 import framework-bom，不写任何框架模块的版本号。
        Spring Boot 的版本仲裁由它传递过来，本插件不再自己 import spring-boot-dependencies。
        （fesod-bom 刻意不 import，理由见上方 <fesod.version> 的注释。）
      -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${describeadmin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      compile：本插件的全部交付物（门面读写、注解 advice/resolver）都建在 Fesod 之上，
      运行时必须在 classpath 上。"重量级依赖 ⇒ 必须做插件"正是 CLAUDE.md 4.6 的判据。
    -->
    <dependency>
      <groupId>org.apache.fesod</groupId>
      <artifactId>fesod-sheet</artifactId>
      <version>${fesod.version}</version>
    </dependency>

    <!--
      compile：FrameworkVersion 启动期自检、Result / ResultCode / BizException / PageResult
      都来自这里。是零依赖的轻量模块，任何 web 消费方必然已经有它——显式声明便于阅读。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-common</artifactId>
    </dependency>

    <!--
      provided + optional：只为让装配测试能加载 FrameworkWebAutoConfiguration、验证本插件
      的 advice/resolver 与它的 GlobalExceptionHandler / FrameworkJsonModule 不冲突。
      生产代码【只用字符串】引 web 自动配置类（afterName），不 import 它的任何类型——
      纯门面（无 Spring MVC）的消费方不该被强迫拖入整个 web starter。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-web-starter</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>

    <!--
      provided：ResponseBodyAdvice / HandlerMethodArgumentResolver / WebMvcConfigurer /
      MultipartFile / ContentDisposition。任何真实消费方的编译期 classpath 上都有它
      （多半经 framework-web-starter 传递）；测试 classpath 自动带上。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- provided：门面签名里的 HttpServletResponse / HttpServletRequest，容器提供。 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      同仓时期由 framework-parent 的 <dependencies> 提供，独立成仓后必须自己声明——
      这类"继承来的隐式依赖"是拆仓最容易漏的东西。assertj-core 经它传递。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- 测试 JVM 必须显式指定 UTF-8，理由同 CLAUDE.md 3.6 -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>${enforcer.java.version}</version>
                  <message>
                    构建本插件需要 JDK 17 或更高版本（用 `mvn -v` 查看 Maven 实际使用的 JDK）。
                  </message>
                </requireJavaVersion>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.mysql:mysql-connector-j</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架与插件均不得依赖任何 JDBC 驱动。驱动由业务方在自己的 pom.xml 中声明。
                  </message>
                </bannedDependencies>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。
                    tools.jackson.* 是 Jackson 3，属于 Spring Boot 4.x 生态。
                    若 fesod-shaded 某天开始漏出 Jackson 3，这条规则会在此拦下。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 发布 profile，与 framework-cache-redis-starter/framework-crypto-starter 保持一致。步骤参照 docs 仓的 RELEASE.md。 -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
